<aside class="library" id="chapterPanel" aria-label="章节目录面板">
  <h2>选择章节</h2>
  <label>
    <input id="catalogSearch" placeholder="活动、章节、代号…" />
  </label>
  <div class="filters">
    <select id="type" aria-label="剧情类型">
      <option value="">全部类型</option>
    </select>
    <select id="sort" aria-label="目录排序">
      <option value="source">目录顺序</option>
      <option value="release">活动开放时间 ↓</option>
    </select>
  </div>
  <nav id="tree" aria-label="章节目录"></nav>
</aside>
