<aside class="library" id="chapterPanel" aria-label="章节目录面板">
  <div class="notesHeading">
    <h2>选择章节</h2>
    <button class="panelClose" data-close-panel type="button" aria-label="关闭章节目录">
      关闭
    </button>
  </div>
  <label>
    <input id="catalogSearch" placeholder="活动、章节、代号…" />
  </label>
  <div class="filters">
    <select id="type" aria-label="剧情类型">
      <option value="">全部类型</option>
    </select>
    <select id="sort" aria-label="目录排序">
      <option value="source">目录顺序</option>
      <option value="release">活动开放时间 ↓</option>
    </select>
  </div>
  <nav id="tree" aria-label="章节目录"></nav>
  <div class="catalogFooter">
    <button id="catalogBackToTop" type="button" aria-label="回到目录最上方">
      ↑ 目录顶部
    </button>
  </div>
</aside>

<script>
  const panel = document.getElementById('chapterPanel');
  document.getElementById('catalogBackToTop')?.addEventListener('click', () => {
    panel?.scrollTo({
      top: 0,
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
  });
</script>

<style>
  :global(#readerView[data-panel='catalog']) .library {
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 1151px) {
    :global(:root:not([data-focus='on']) #readerView) .library {
      display: flex;
      flex-direction: column;
    }
  }
  .library > * {
    flex-shrink: 0;
  }
  #tree {
    flex-grow: 1;
  }
  .catalogFooter {
    position: sticky;
    bottom: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
    pointer-events: none;
  }
  .catalogFooter button {
    pointer-events: auto;
    padding: 6px 10px;
    font-size: 12px;
    white-space: nowrap;
    background: var(--panel);
    box-shadow: 0 2px 8px #0001;
  }
</style>
