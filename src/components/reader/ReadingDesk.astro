<main>
  <div class="readerHeader">
    <div class="readerTop">
      <div>
        <div class="eyebrow">02 / READING DESK</div>
        <p id="breadcrumb" class="muted">
          请选择章节
        </p>
      </div>
      <div>
        <button id="prev" title="同一目录上一章">
          ← 上一篇
        </button>
        <button id="next">下一篇 →</button>
      </div>
    </div>
    <h1 id="title">从原文开始，理解泰拉。</h1>
    <div class="readerActions">
      <button id="catalogToggle" aria-controls="chapterPanel" aria-expanded="false">
        目录
      </button>
      <input id="find" type="search" placeholder="篇内查找…" aria-label="篇内查找" />
      <details id="readingSettings" class="readerMenu">
        <summary>阅读设置</summary>
        <div class="menuBody readingControls">
          <label>
            字体
            <select id="readingFont" aria-label="正文字体">
              <option value="wenkai">霞鹜文楷</option>
              <option value="serif">书卷宋体</option>
              <option value="sans">清晰黑体</option>
            </select>
          </label>
          <label for="size">字号</label>
          <button id="size" type="button" aria-pressed="false">
            标准
          </button>
          <label>
            行距
            <select id="lineSpacing" aria-label="正文行距">
              <option value="comfortable">舒适</option>
              <option value="close">适中</option>
              <option value="loose">宽松</option>
            </select>
          </label>
          <label for="compactToggle">段落间距</label>
          <button id="compactToggle" type="button" aria-pressed="false">
            紧凑模式
          </button>
        </div>
      </details>
      <details id="readerFilters" class="readerMenu">
        <summary>筛选与原文</summary>
        <div class="menuBody toolbar">
          <p class="muted" id="subtitle"></p>
          <select id="mode" aria-label="显示内容">
            <option value="read">正文阅读</option>
            <option value="all">正文与脚本指令</option>
            <option value="raw">查看源 JSON</option>
          </select>
          <select id="speaker" aria-label="说话人筛选">
            <option value="">全部说话人</option>
          </select>
          <button id="clearFilters">清除筛选与查找</button>
        </div>
      </details>
      <button
        id="focusToggle"
        type="button"
        aria-pressed="false"
        title="收起目录和笔记，保留阅读位置"
      >
        专注阅读
      </button>
      <button id="inspectorToggle" type="button" aria-controls="notesPanel" aria-expanded="false">
        笔记与出处
      </button>
    </div>
    <p id="filterStatus" class="hint" role="status" hidden></p>
  </div>
  <details id="notice" class="notice" hidden>
    <summary id="noticeTitle"></summary>
    <p id="noticeDetail"></p>
  </details>
  <details id="brief">
    <summary>简介与 LLM 生成摘要（可能剧透）</summary>
    <h4>游戏简介 · storyInfo</h4>
    <p id="briefText"></p>
    <h4>数据来源上游 LLM 生成摘要 · 不作为原文事实</h4>
    <p id="summaryText"></p>
  </details>
  <div id="searchHighlightBar" class="searchHighlightBar" hidden>
    <span id="searchHighlightLabel"></span>
    <button id="clearSearchHighlight" type="button">
      清除关键词高亮
    </button>
  </div>
  <section id="content" aria-live="polite">
    <div class="empty">
      正在释放神经递质……
    </div>
  </section>
</main>
