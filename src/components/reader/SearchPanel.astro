<section id="searchView" class="appPage" hidden aria-labelledby="searchTitle">
  <div class="searchPageHead">
    <h1 id="searchTitle">全文检索</h1>
  </div>
  <section id="searchPane">
    <div class="corpusForm">
      <label>
        全库关键词
        <input id="globalQuery" placeholder="输入关键词…" maxlength="100" />
      </label>
      <label>
        检索字段
        <select id="searchField">
          <option value="all">正文与发言标签</option>
          <option value="text">仅正文 / 选项</option>
          <option value="speaker">仅发言标签</option>
        </select>
      </label>
      <button id="searchGo" class="primary">
        查询全库
      </button>
      <span id="searchStatus" class="hint" role="status">
      覆盖当前资料库全部剧情文本，结果可翻页；不调用 LLM。
      </span>
      
    </div>
    

    <div class="searchFilterRow">
      <label>
        关键词所在篇章
        <select id="searchChapter" disabled>
          <option value="">全部命中篇章</option>
        </select>
      </label>
      <div class="searchPager">
        <button id="searchPrev" disabled>
          ← 上一页
        </button>
        <span id="searchPage">—</span>
        <button id="searchNext" disabled>
          下一页 →
        </button>
      </div>
    </div>
    <div id="results"></div>
  </section>
</section>
