---
import SiteLayout from './SiteLayout.astro';
import { sitePath } from '../lib/routes.js';
interface Props {
  page: 'acknowledgements';
  title: string;
  description: string;
  eyebrow: string;
  headings: { slug: string; text: string }[];
}
const { page, title, description, eyebrow, headings } = Astro.props;
---

<SiteLayout page={page} title={title} description={description}>
  <main class="documentPage pageShell">
    <aside class="documentContents" aria-label="本页目录">
      <p class="eyebrow">ON THIS PAGE</p>
      <nav aria-label="致谢章节">
        {headings.map(({ slug, text }) => (
          <a href={`#${slug}`}>{text}</a>
        ))}
      </nav>
      <a class="backToReader" href={sitePath('reader/')}>
        继续阅读 →
      </a>
    </aside>
    <article class="documentBody">
      <p class="eyebrow">{eyebrow}</p>
      <div class="prose">
        <slot />
      </div>
      <footer>
        <a href={sitePath()}>← 返回首页</a>
        <a href={sitePath('reader/')}>前往阅读 →</a>
      </footer>
    </article>
  </main>
</SiteLayout>
<style>
  .documentPage {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    align-items: start;
    gap: 64px;
  }
  .documentContents {
    position: sticky;
    top: calc(var(--app-header-height) + 40px);
    padding: 20px 0;
  }
  .documentContents nav {
    display: grid;
    gap: 5px;
    margin: 20px 0 28px;
  }
  .documentContents nav a {
    border-left: 1px solid var(--border);
    padding: 8px 16px;
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }
  .documentContents nav a:hover,
  .documentContents nav a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--active);
  }
  .backToReader {
    display: inline-block;
    font-size: 13px;
    padding-left: 16px;
    text-decoration: none;
  }
  .documentBody {
    max-width: 820px;
    min-width: 0;
    padding: 20px 0;
  }
  .prose {
    font-family: var(--reading-font);
    font-size: var(--reading-size);
    line-height: 1.95;
    letter-spacing: 0.025em;
    overflow-wrap: anywhere;
  }
  .prose :global(h1) {
    font-size: clamp(28px, 3.5vw, 40px);
    margin: 12px 0 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(h2) {
    font-family: var(--ui-font);
    font-size: 20px;
    margin: 40px 0 18px;
    color: var(--accent);
    scroll-margin-top: calc(var(--app-header-height) + 28px);
  }
  .prose :global(p),
  .prose :global(li) {
    margin-block: 16px;
  }
  .prose :global(ul) {
    padding-left: 1.4em;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(a) {
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(code) {
    font:
      0.8em/1.6 Consolas,
      monospace;
    letter-spacing: 0;
    padding: 2px 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }
  @media (max-width: 1000px) {
    .documentPage {
      gap: 32px;
      grid-template-columns: 150px minmax(0, 1fr);
    }
  }
  @media (max-width: 750px) {
    .documentPage {
      display: block;
    }
    .documentContents {
      position: static;
      padding: 0 0 24px;
      border-bottom: 1px solid var(--border);
    }
    .documentContents nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 14px 0 0;
    }
    .documentContents nav a {
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 6px 10px;
    }
    .backToReader {
      display: none;
    }
    .documentBody {
      padding-top: 28px;
    }
    .prose {
      font-size: 17px;
    }
  }
</style>
