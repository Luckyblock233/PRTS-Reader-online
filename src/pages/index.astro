---
import homeContent from "../../config/home.example.json";
import "../../reader/style.css";
import "../../reader/features.css";
import "../../reader/reading.css";
import "../../reader/application.css";
import "../../reader/reader-layout.css";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>泰拉 · 纪事</title>
    <script is:inline src={`${import.meta.env.BASE_URL}/preferences.js?v=reading-8`}></script>
    <meta name="description" content="在线阅读明日方舟剧情，检索对白、收藏段落并记录观察。" />
  </head>
  <body>
    <header class="appHeader">
      <a class="brand" href="#home" aria-label="泰拉纪事首页"
        ><span class="mark"></span>
        <div>泰拉 · 纪事<small>TERRA / RECORDS</small></div></a
      >
      <nav class="appNav" aria-label="应用导航">
        <button id="homeNav" type="button" aria-current="page">首页</button
        ><button id="readerNav" type="button">阅读</button>
        <a class="thanksLink" href={`${import.meta.env.BASE_URL}/acknowledgements/`}>致谢</a>
      </nav>
      <form id="topSearchForm" class="topSearch" role="search">
        <input id="topSearchQuery" aria-label="全文检索关键词" maxlength="80" /><button
          id="openGlobalSearch"
          type="submit"
        >
          全文检索
        </button>
      </form>
      <button id="themeToggle" type="button" aria-label="切换到夜间模式">☾</button>
    </header>
    <section id="homeView" class="appPage" aria-labelledby="homeTitle">
      <div class="homeHero">
        <div class="eyebrow">TERRA / A PERSONAL READING ROOM</div>
        <h1 id="homeTitle">{homeContent.title}</h1>
        <p id="homeIntro">{homeContent.intro}</p>
        <div class="homeActions">
          <button id="homeRead" type="button" class="primary">继续阅读 →</button
          ><button id="homeSearch" type="button">探索全文检索</button>
          <p id="homeResumeLabel" class="hint">正在读取上次阅读位置…</p>
        </div>
      </div>
      <div class="homeMeta">
        <span><strong id="homeChapterCount">—</strong> 篇剧情</span
        ><span><strong id="homeLineCount">—</strong> 条源记录</span>
      </div>
      <div id="homeSections" class="homeSections">
        {homeContent.sections.map((section, index) => (
          <article class="homeSection">
            <span class="homeNumber">{String(index + 1).padStart(2, "0")}</span>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </div>
      <section class="homeUpdates" aria-labelledby="dataUpdateTitle">
        <div class="eyebrow">DATA / PUBLISHED SNAPSHOT</div>
        <div class="updateHeading">
          <h2 id="dataUpdateTitle">剧情数据版本</h2>
          <button id="sources" type="button">来源与版本</button>
        </div>
        <p>本站使用经过校验的固定剧情快照，数据随网站发布更新。笔记和阅读位置仅保存在当前浏览器，请定期导出备份。</p>
        <a href="https://github.com/Luckyblock233/PRTS-Reader-online/actions" target="_blank" rel="noopener noreferrer">查看网站发布记录 ↗</a>
      </section>
      <div class="wiki homeReference">
        <span class="eyebrow">EXTERNAL REFERENCE</span>
        <h3>PRTS 泰拉年表 ↗</h3>
        <p class="hint">玩家整理，包含推测与未定时间。未导入本地，不与剧情顺序自动对齐。</p>
        <a href="https://prts.wiki/w/泰拉年表" target="_blank" rel="noopener noreferrer"
          >打开 Wiki 年表</a
        >
        · <a href="https://prts.wiki/w/首页" target="_blank" rel="noopener noreferrer">首页</a>
      </div>
      <footer class="homeRights" aria-labelledby="rightsTitle">
        <h2 id="rightsTitle">权利说明</h2>
        <p>泰拉纪事是非官方《明日方舟》剧情阅读工具，不代表游戏官方或数据源维护者。游戏文本、图片及角色等内容的权利归原权利人所有。</p>
        <p>应用代码采用 MIT 许可，阅读字体遵循 SIL Open Font License 1.1；应用代码的许可不改变游戏素材及其他第三方内容的权利归属。使用或再分发相关内容时，请遵守各自的许可与使用条件。</p>
        <a href={`${import.meta.env.BASE_URL}/acknowledgements/`}>致谢与完整第三方说明 →</a>
      </footer>
    </section>

    <div id="readerView" class="workspace" hidden>
      <aside class="library" id="chapterPanel" aria-label="章节目录面板">
        <button class="panelClose" data-close-panel type="button">关闭目录</button>
        <h2>剧情资料库</h2>
        <p class="muted" id="stats">正在读取剧情数据…</p>
        <label>目录检索<input id="catalogSearch" placeholder="活动、章节、代号…" /></label>
        <div class="filters">
          <select id="type" aria-label="剧情类型">
            <option value="">全部类型</option></select
          ><select id="sort" aria-label="目录排序">
            <option value="source">目录顺序</option>
            <option value="release">活动开放时间 ↓</option>
          </select>
        </div>
        <p class="hint">目录序号与开放时间都不代表泰拉世界时间。</p>
        <nav id="tree" aria-label="章节目录"></nav>
      </aside>
      <main>
        <div class="readerHeader">
          <div class="readerTop">
            <div>
              <div class="eyebrow">02 / READING DESK</div>
              <p id="breadcrumb" class="muted">请选择章节</p>
            </div>
            <div>
              <button id="prev" title="同一目录上一章">← 上一篇</button
              ><button id="next">下一篇 →</button>
            </div>
          </div>
          <h1 id="title">从原文开始，理解泰拉。</h1>
          <div class="readerActions">
            <button id="catalogToggle" aria-controls="chapterPanel" aria-expanded="false">
              目录
            </button>
            <input id="find" type="search" placeholder="篇内查找…" aria-label="篇内查找" />
            <details id="readingSettings" class="readerMenu">
              <summary>阅读设置</summary>
              <div class="menuBody readingControls">
                <label
                  >字体<select id="readingFont" aria-label="正文字体">
                    <option value="wenkai">霞鹜文楷</option>
                    <option value="serif">书卷宋体</option>
                    <option value="sans">清晰黑体</option>
                  </select></label
                >
                <label for="size">字号</label
                ><button id="size" type="button" aria-pressed="false">标准</button>
                <label
                  >行距<select id="lineSpacing" aria-label="正文行距">
                    <option value="comfortable">舒适</option>
                    <option value="close">适中</option>
                    <option value="loose">宽松</option>
                  </select></label
                >
                <label for="compactToggle">段落间距</label
                ><button id="compactToggle" type="button" aria-pressed="false">紧凑模式</button>
              </div>
            </details>
            <details id="readerFilters" class="readerMenu">
              <summary>筛选与原文</summary>
              <div class="menuBody toolbar">
                <p class="muted" id="subtitle"></p>
                <select id="mode" aria-label="显示内容">
                  <option value="read">正文阅读</option>
                  <option value="all">正文与脚本指令</option>
                  <option value="raw">查看源 JSON</option>
                </select>
                <select id="speaker" aria-label="说话人筛选">
                  <option value="">全部说话人</option>
                </select>
                <button id="clearFilters">清除筛选与查找</button>
              </div>
            </details>
            <button
              id="focusToggle"
              type="button"
              aria-pressed="false"
              title="收起目录和笔记，保留阅读位置"
            >
              专注阅读
            </button>
            <button
              id="inspectorToggle"
              type="button"
              aria-controls="notesPanel"
              aria-expanded="false"
            >
              笔记与出处
            </button>
          </div>
          <p id="filterStatus" class="hint" role="status" hidden></p>
        </div>
        <details id="notice" class="notice" hidden>
          <summary id="noticeTitle"></summary>
          <p id="noticeDetail"></p>
        </details>
        <details id="brief">
          <summary>简介与生成摘要（可能剧透）</summary>
          <h4>游戏简介 · storyInfo</h4>
          <p id="briefText"></p>
          <h4>上游 LLM 生成摘要 · 不作为原文事实</h4>
          <p id="summaryText"></p>
        </details>
        <div id="searchHighlightBar" class="searchHighlightBar" hidden>
          <span id="searchHighlightLabel"></span
          ><button id="clearSearchHighlight" type="button">清除关键词高亮</button>
        </div>
        <section id="content" aria-live="polite">
          <div class="empty">载入剧情资料库后即可阅读。<br />无需模型 API 或数据库服务。</div>
        </section>
        <footer id="readingFooter"></footer>
      </main>
      <div id="focusFigureSlot" aria-label="专注阅读立绘"></div>
      <aside class="inspector" id="notesPanel" aria-label="段落笔记与出处">
        <div class="notesHeading">
          <h2>笔记与出处</h2>
          <button class="panelClose" data-close-panel type="button" aria-label="关闭笔记与出处">
            关闭
          </button>
        </div>
        <details class="figureCard" open>
          <summary>角色立绘</summary>
          <div class="figureHeading">
            <span id="figureName">选择一段对白</span><span class="figureBadge">AVG</span>
          </div>
          <div id="figureStage" class="figureStage">
            <img id="figureImage" alt="" hidden />
            <p id="figureEmpty">点击记录，在此查看对应立绘。</p>
          </div>
          <details>
            <summary>资源详情</summary>
            <p id="figureRef" class="hint">figure_art · 尚未选择</p>
            <p id="figureStatus" class="hint">只展示记录明确引用的资源，不用立绘推断角色身份。</p>
          </details>
        </details>
        <section id="notesPane">
          <h3>所选段落</h3>
          <blockquote id="selectedQuote">请选择段落</blockquote>
          <details class="sourceDetails">
            <summary>段落出处</summary>
            <div id="selection" class="selection">尚未选择段落</div>
            <details>
              <summary>源记录 JSON</summary>
              <pre id="lineRaw"></pre>
            </details>
          </details>

          <label for="note">笔记</label>
          <textarea id="note" rows="4" placeholder="写下你的观察…"></textarea>
          <div class="actions">
            <button id="saveNote" class="primary">保存笔记</button
            ><button id="bookmark">☆ 收藏段落</button>
          </div>

          <details class="savedNotes">
            <summary>笔记与收藏 <span id="noteCount">0</span></summary>
            <div id="noteList"></div>
            <div class="noteTransfer">
              <button id="export">导出 JSON</button
              ><label class="fileLabel"
                >导入 JSON<input id="import" type="file" accept="application/json,.json"
              /></label>
            </div>
            <p class="hint" id="noteStatus">笔记仅保存在此浏览器，可导出备份。</p>
          </details>
        </section>
        <label class="notesBehaviorLabel"
          >侧栏显示<select id="notesBehavior" aria-label="笔记侧栏显示">
            <option value="auto">默认收起</option>
            <option value="pinned">保持展开</option>
          </select></label
        >
      </aside>
    </div>
    <section id="searchView" class="appPage" hidden aria-labelledby="searchTitle">
      <div class="searchPageHead">
        <div>
          <div class="eyebrow">FULL TEXT / ACROSS TERRA</div>
          <h1 id="searchTitle">全文检索</h1>
          <p>从一句对白出发，找回它所在的篇章与上下文。</p>
        </div>
      </div>
      <section id="searchPane">
        <div class="corpusForm">
          <label
            >全库关键词<input
              id="globalQuery"
              placeholder="输入关键词（支持单字）…"
              maxlength="100" /></label
          ><label
            >检索字段<select id="searchField">
              <option value="all">正文与发言标签</option>
              <option value="text">仅正文 / 选项</option>
              <option value="speaker">仅发言标签</option>
            </select></label
          ><button id="searchGo" class="primary">查询全库</button>
        </div>
        <p id="searchStatus" class="hint" role="status">
          覆盖当前资料库全部剧情文本，结果可翻页；不调用 LLM。
        </p>
        <div class="searchFilterRow">
          <label
            >关键词所在篇章<select id="searchChapter" disabled>
              <option value="">全部命中篇章</option>
            </select></label
          >
          <div class="searchPager">
            <button id="searchPrev" disabled>← 上一页</button><span id="searchPage">—</span
            ><button id="searchNext" disabled>下一页 →</button>
          </div>
        </div>
        <div id="results"></div>
      </section>
    </section>
    <dialog id="sourceDialog">
      <button id="closeDialog" class="close">关闭 ×</button>
      <h2>来源与版本</h2>
      <p>
        本阅读器展示发布包中的 ASTR 转换 JSON，未包含转换前 TXT。段落定位使用数组下标；sourceId
        保留上游行号，二者不可互换。
      </p>
      <pre id="sourceInfo"></pre>
      <p>
        仅按文本字段投影，不识别实体、事件、因果、伏笔或世界时间。发言标签未经角色身份消歧。正文模式保留全部分支内容，选项仅用于核对跳转。
      </p>
      <p>
        <a id="releaseLink" target="_blank" rel="noopener noreferrer"
          >查看锁定的 GitHub Release ↗</a
        >
      </p>
    </dialog>
    <button id="exitFocus" type="button" hidden>退出专注 · Esc</button>
    <div id="toast" role="status"></div>
    <script>import "../../reader/app.js";</script>
  </body>
</html>
