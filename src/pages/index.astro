---
import SiteLayout from '../layouts/SiteLayout.astro';
import SourceDialog from '../components/SourceDialog.astro';
import { readFile } from 'node:fs/promises';
import { sitePath } from '../lib/routes.js';
import { formatPublishedAt } from '../lib/date.js';
const catalog = JSON.parse(await readFile('reader/data/catalog.json', 'utf8'));
const { snapshot } = catalog;
const lineCount = catalog.chapters.reduce((sum, chapter) => sum + chapter.lineCount, 0);
---

<SiteLayout page="home">
  <main id="homeView" class="pageShell" data-snapshot-id={snapshot.id} aria-labelledby="homeTitle">
    <div class="homeHero">
      <h1 id="homeTitle">“今天有在好好执行源石计划吗？”</h1>
      <p id="homeIntro">————Love from your PRTS.</p>
      <div class="homeActions">
        <a id="homeRead" class="button primary" href={sitePath('reader/')}>
          继续阅读 →
        </a>
        <a id="homeSearch" class="button" href={`${sitePath('reader/')}#search`}>
          探索全文检索
        </a>
        <p id="homeResumeLabel" class="hint">
          选择一篇剧情，开始阅读
        </p>
      </div>
    </div>

    <section class="homeUpdates" aria-labelledby="dataUpdateTitle">
      <div class="updateHeading">
        <h2 id="dataUpdateTitle">剧情数据版本</h2>
        <button id="sources" type="button">
          来源与版本
        </button>
      </div>
      <div class="homeMeta">
        <span>
          <strong id="homeChapterCount">{catalog.chapters.length.toLocaleString('zh-CN')}</strong>{' '}
          篇剧情
        </span>
        <span>
          <strong id="homeLineCount">{lineCount.toLocaleString('zh-CN')}</strong> 条源记录
        </span>
        <span class="homePublished">
          <strong>
            <time id="homePublishedAt" datetime={snapshot.publishedAt}>
              {formatPublishedAt(snapshot.publishedAt)}
            </time>
          </strong>
          发布（UTC+8）
        </span>
      </div>
      <p>本站使用经过校验的固定剧情快照，剧情数据随网站发布更新。</p>
      <p>笔记和阅读位置仅保存在当前浏览器，安全起见，请定期导出备份。</p>
    </section>
  </main>
  <SourceDialog snapshot={snapshot} />
  <script>
    import '../scripts/home.js';
  </script>
</SiteLayout>

<style>
  .homeHero {
    position: relative;
    padding: 18px 0 36px;
    border-bottom: 1px solid var(--border);
  }
  .homeHero h1 {
    font-size: clamp(32px, 4vw, 52px);
    max-width: 900px;
    margin: 25px 0 16px;
    letter-spacing: 0.04em;
  }
  .homeHero #homeIntro {
    max-width: 760px;
    font-size: 17px;
    line-height: 1.9;
    color: var(--muted);
    white-space: pre-wrap;
  }
  .homeActions {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .homeActions .button {
    padding: 11px 22px;
  }
  .homeActions .hint {
    flex-basis: 100%;
    margin: 0;
  }
  .homeMeta {
    display: flex;
    gap: 30px;
    margin: 24px 0 0;
    flex-wrap: wrap;
    align-items: center;
  }
  .homeMeta span {
    font-size: 12px;
    color: var(--muted);
  }
  .homeMeta strong {
    font:
      24px Georgia,
      serif;
    color: var(--accent);
    margin-right: 6px;
  }
  .homePublished {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .homePublished time {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .homeUpdates {
    margin-top: 32px;
  }
  .homeUpdates > p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
  }
  .updateHeading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .updateHeading h2 {
    font-size: 22px;
    margin: 6px 0;
  }
  .updateHeading button {
    flex-shrink: 0;
  }
  @media (max-width: 500px) {
    .homeMeta {
      gap: 16px;
    }
  }
  @media (max-width: 500px) {
    .homeHero h1 {
      font-size: 32px;
    }
  }
  @media (max-width: 500px) {
    .homeHero #homeIntro {
      font-size: 15px;
    }
  }
</style>
