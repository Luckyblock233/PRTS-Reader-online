---
import SiteLayout from '../layouts/SiteLayout.astro';
import ChapterLibrary from '../components/reader/ChapterLibrary.astro';
import ReadingDesk from '../components/reader/ReadingDesk.astro';
import NotesPanel from '../components/reader/NotesPanel.astro';
import SearchPanel from '../components/reader/SearchPanel.astro';
import FigureViewer from '../components/reader/FigureViewer.astro';
import '../../reader/style.css';
import '../../reader/features.css';
import '../../reader/reading.css';
import '../../reader/application.css';
import '../../reader/reader-layout.css';
import '../../reader/figure-viewer.css';
import '../../reader/reader-controls.css';
---

<SiteLayout page="reader" title="阅读 · 泰拉纪事">
  <div id="readerView" class="workspace">
    <ChapterLibrary />
    <ReadingDesk />
    <div id="focusFigureSlot" aria-label="专注阅读立绘"></div>
    <NotesPanel />
    <div class="readerRestoreControls" role="group" aria-label="恢复阅读面板">
      <button id="readerToolsShow" type="button" aria-controls="readerTools" hidden>
        显示工具栏
      </button>
      <button id="figureShow" type="button" hidden>
        显示立绘
      </button>
    </div>
  </div>
  <SearchPanel />
  <FigureViewer />
  <button id="exitFocus" type="button" hidden>
    退出专注 · Esc
  </button>
  <div id="toast" role="status"></div>
  <script>
    import '../../reader/app.js';
  </script>
</SiteLayout>
